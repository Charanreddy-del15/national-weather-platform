# Application Environment Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=weathervani_super_secret_jwt_key_2026

# Database & Spatial Configuration
DATABASE_URL=sqlite:///./data/weather_platform.db
POSTGRES_DB=weather_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis & Caching
REDIS_URL=redis://localhost:6379/0

# Kafka Distributed Streaming Bus
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW=weather.events.raw
KAFKA_TOPIC_VERIFIED=weather.events.verified

# Public Weather API Adapters
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
IMD_API_ENDPOINT=https://mausam.imd.gov.in/api
